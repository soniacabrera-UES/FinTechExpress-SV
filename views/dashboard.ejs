<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Dashboard - FinTech Express SV</title>
  <style>
    body { font-family: sans-serif; background-color: #f4f4f9; margin: 0; padding: 2rem; }
    .dashboard-container { max-width: 800px; margin: auto; background: white; padding: 2rem; border-radius: 8px; box-shadow: 0 4px 8px rgba(0,0,0,0.1); }
    h1 { color: #004085; }
    .balance { font-size: 2.5rem; color: #28a745; margin-top: 1rem; font-weight: bold;}
    .api-info { background: #e9ecef; padding: 1rem; border-radius: 4px; margin-top: 2rem; font-family: monospace; }
  </style>
</head>
<body>
  <div class="dashboard-container">
    
    <!-- VULNERABILIDAD PARA OWASP ZAP (Cross-Site Scripting - XSS) -->
    <!-- La etiqueta <%- %> en EJS genera datos sin escapar. -->
    <h1>Bienvenido a tu Banca Móvil, <%- username %>!</h1>
    
    <p>Titular de la cuenta: <%= full_name %></p>
    <p>Saldo actual disponible:</p>
    <div class="balance">$<%= balance %> USD</div>

    <div class="api-info">
      <p><strong>Info para Desarrolladores (API):</strong></p>
      <p>Su Token JWT Activo: <span style="word-break: break-all; color: #dc3545;"><%= token %></span></p>
      <p>Consultar transacciones: <a href="/api/transactions?account_id=<%= accountId %>" target="_blank">/api/transactions?account_id=<%= accountId %></a></p>
    </div>
  </div>
</body>
</html>
